# Copy to .env for local dev (never commit .env). Render/Vercel set these in
# their own dashboards.

# --- Postgres (Neon free tier or Render Postgres). Needs a read/write role. ---
DATABASE_URL=postgresql://user:pass@host:5432/paper_radar

# --- Shared secret: Vercel dashboard <-> worker web service ---
INTERNAL_SHARED_SECRET=generate-a-long-random-string

# --- Telegram digest delivery (optional; run just skips delivery if unset) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Public dashboard URL — only used for the "full digest" link in Telegram ---
DASHBOARD_URL=

# --- Enrichment (all optional; system degrades to arXiv-only) ---
OPENALEX_API_KEY=
CORE_API_KEY=
CROSSREF_MAILTO=you@university.edu
SEMANTIC_SCHOLAR_API_KEY=

# --- arXiv politeness (defaults are correct — do not lower the interval) ---
ARXIV_MIN_INTERVAL_SECONDS=3.0
ARXIV_MAX_RETRIES=5
ARXIV_BACKOFF_START_SECONDS=5.0

# --- Sizing knobs ---
DAILY_MAX_RESULTS_PER_QUERY=100
TERM_BACKFILL_MAX_REQUESTS=8
TERM_BACKFILL_PAGE_SIZE=100
BOOTSTRAP_HISTORY_WEEKS=14
BOOTSTRAP_MAX_REQUESTS=40

# --- Worker web service URL, for the dashboard (Vercel side only) ---
# WORKER_INTERNAL_URL=https://paper-radar-worker-api.onrender.com
